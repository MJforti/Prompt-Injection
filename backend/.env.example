# Copy to backend/.env (never commit the real file). All values are optional:
# without them ContextShield runs with the mock simulator only.

# Any OpenAI-compatible endpoint (OpenAI, Google Gemini, Groq, OpenRouter, Ollama, LM Studio, ...)
#
# Google Gemini example (key from https://aistudio.google.com/apikey):
#   CONTEXTSHIELD_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   CONTEXTSHIELD_LLM_MODEL=gemini-2.5-flash
#
# OpenAI example:
#   CONTEXTSHIELD_LLM_BASE_URL=https://api.openai.com/v1
#   CONTEXTSHIELD_LLM_MODEL=<model id from your provider>
CONTEXTSHIELD_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CONTEXTSHIELD_LLM_API_KEY=
CONTEXTSHIELD_LLM_MODEL=gemini-2.5-flash

# Seconds to wait for one LLM call
CONTEXTSHIELD_LLM_TIMEOUT=60

# SQLite file location (default: backend/data/contextshield.db)
# CONTEXTSHIELD_DB_PATH=

# Allowed frontend origins
# CONTEXTSHIELD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
